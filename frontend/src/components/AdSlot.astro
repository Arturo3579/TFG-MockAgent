---
export interface Props {
  position?: 'inline' | 'sidebar';
  label?: string;
}

const { position = 'inline', label = 'Advertisement' } = Astro.props;
---

<div class={`ad-slot ad-slot--${position}`} aria-label={label}>
  <span class="ad-label">{label}</span>
  <div class="ad-placeholder">
    <span>Ad space reserved</span>
  </div>
</div>

<style>
  .ad-slot {
    margin: 2rem 0;
    padding: 1rem;
    background-color: rgba(22, 35, 63, 0.02);
    border: 1px dashed var(--border-light);
    border-radius: var(--radius-md);
    text-align: center;
  }

  .ad-label {
    display: block;
    font-size: 0.65rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--slate-gray);
    margin-bottom: 0.5rem;
  }

  .ad-placeholder {
    min-height: 90px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .ad-slot--sidebar {
    margin: 0;
  }

  @media (max-width: 640px) {
    .ad-placeholder {
      min-height: 70px;
    }
  }
</style>
