---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="footer-mark">MA</span>
      <div>
        <strong>MockAgent.AI</strong>
        <p>Field-reviewed guides to AI tools for independent insurance agents.</p>
      </div>
    </div>

    <nav class="footer-nav" aria-label="Footer navigation">
      <a href="/articles">Articles</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a href="/privacy">Privacy Policy</a>
      <a href="/terms">Terms & Disclaimer</a>
    </nav>

    <p class="footer-legal">
      © {currentYear} MockAgent.AI. All content is for educational purposes and is not legal, compliance, or insurance advice.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--ink-navy);
    color: rgba(255, 255, 255, 0.8);
    padding: 3rem 0 1.5rem;
    margin-top: 4rem;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .footer-brand {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .footer-mark {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--brass);
    color: var(--ink-navy);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .footer-brand strong {
    color: var(--white);
    font-family: var(--font-display);
    font-size: 1.15rem;
    display: block;
    margin-bottom: 0.25rem;
  }

  .footer-brand p {
    margin: 0;
    font-size: 0.9rem;
    max-width: 400px;
    color: rgba(255, 255, 255, 0.7);
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .footer-nav a {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color var(--transition-fast);
  }

  .footer-nav a:hover {
    color: var(--white);
  }

  .footer-legal {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.5);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 1.25rem;
    margin: 0;
  }

  @media (max-width: 640px) {
    .footer-nav {
      gap: 0.875rem;
    }
  }
</style>
