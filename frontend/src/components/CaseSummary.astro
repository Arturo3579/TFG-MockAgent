---
export interface Props {
  points: string[];
}

const { points } = Astro.props;
---

<aside class="case-summary" aria-labelledby="case-summary-title">
  <div class="case-summary-tab">
    <span>Case Summary</span>
  </div>
  <h3 id="case-summary-title" class="sr-only">Key takeaways</h3>
  <ul>
    {points.map(point => (
      <li>{point}</li>
    ))}
  </ul>
</aside>

<style>
  .case-summary {
    background-color: var(--white);
    border: 1px solid var(--border-light);
    border-left: 4px solid var(--brass);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    margin: 2rem 0;
    position: relative;
    box-shadow: 0 2px 8px rgba(22, 35, 63, 0.04);
    opacity: 0;
    transform: translateY(12px);
    animation: fadeIn 0.5s ease forwards;
  }

  .case-summary-tab {
    position: absolute;
    top: -12px;
    left: 1.5rem;
    background-color: var(--brass);
    color: var(--white);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
  }

  .case-summary ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .case-summary li {
    position: relative;
    padding-left: 1.5rem;
    margin: 0;
    color: var(--ink-navy);
    line-height: 1.55;
  }

  .case-summary li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--brass);
    font-weight: 700;
  }

  @keyframes fadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .case-summary {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
