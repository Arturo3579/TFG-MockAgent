---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Contact | MockAgent.AI"
  description="Contact MockAgent.AI with questions, corrections, or partnership inquiries about AI tools for insurance agents."
>
  <div class="page-header">
    <div class="container container-narrow">
      <h1>Contact</h1>
      <p class="page-lead">Questions, corrections, or partnership inquiries.</p>
    </div>
  </div>

  <section class="content-section">
    <div class="container container-narrow">
      <p>
        We read every message. Typical response time is 2-3 business days.
      </p>

      <div class="contact-options">
        <div class="contact-card">
          <h2>Email us</h2>
          <div class="email-row">
            <a href="mailto:mockagentai@gmail.com" class="email-link">mockagentai@gmail.com</a>
            <button type="button" class="copy-btn" data-copy="mockagentai@gmail.com" aria-label="Copy email address">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span class="copy-label">Copy</span>
            </button>
          </div>
        </div>
      </div>

      <div class="notice">
        <strong>We do not provide insurance, legal, or compliance advice.</strong> 
        For questions about your specific licensing, appointments, or regulatory obligations, please contact your 
        state Department of Insurance or a qualified attorney.
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  (function() {
    document.querySelectorAll('[data-copy]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        const text = btn.getAttribute('data-copy');
        const label = btn.querySelector('.copy-label');
        const originalLabel = label ? label.textContent : 'Copy';

        function showCopied() {
          btn.classList.add('copied');
          if (label) label.textContent = 'Copied!';
          setTimeout(function() {
            btn.classList.remove('copied');
            if (label) label.textContent = originalLabel;
          }, 2000);
        }

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(showCopied).catch(function() {
            fallbackCopy(text);
            showCopied();
          });
        } else {
          fallbackCopy(text);
          showCopied();
        }

        function fallbackCopy(value) {
          const input = document.createElement('input');
          input.value = value;
          input.setAttribute('readonly', '');
          input.style.position = 'absolute';
          input.style.left = '-9999px';
          document.body.appendChild(input);
          input.select();
          try {
            document.execCommand('copy');
          } catch (e) {
            // ignore
          }
          document.body.removeChild(input);
        }
      });
    });
  })();
</script>

<style>
  .page-header {
    padding: 3rem 0 1.5rem;
    text-align: center;
    background-color: var(--white);
    border-bottom: 1px solid var(--border-light);
  }

  .page-lead {
    color: var(--slate-gray);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .content-section {
    padding: 2rem 0 4rem;
  }

  .contact-options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    margin: 2rem 0;
  }

  .contact-card {
    display: block;
    padding: 1.5rem;
    background-color: var(--white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--transition-fast);
  }

  .contact-card:hover {
    border-color: var(--brass);
  }

  .contact-card h2 {
    border: none;
    margin: 0 0 0.5rem;
    font-size: 1.2rem;
    color: var(--ink-navy);
  }

  .email-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .email-link {
    color: var(--brass);
    font-weight: 600;
    text-decoration: none;
  }

  .email-link:hover {
    text-decoration: underline;
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.6rem;
    background-color: var(--white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-sm);
    color: var(--slate-gray);
    font-size: 0.85rem;
    font-family: inherit;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .copy-btn:hover {
    border-color: var(--brass);
    color: var(--brass);
  }

  .copy-btn.copied {
    border-color: var(--success-green, #2e7d32);
    color: var(--success-green, #2e7d32);
  }

  .notice {
    padding: 1.25rem;
    background-color: rgba(201, 122, 43, 0.08);
    border-left: 3px solid var(--risk-amber);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    color: var(--ink-navy);
  }
</style>
