---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Terms & Disclaimer | MockAgent.AI"
  description="Terms of Use and disclaimer for MockAgent.AI. Content is educational, not legal, compliance, or insurance advice."
  noindex={true}
>
  <div class="page-header">
    <div class="container container-narrow">
      <h1>Terms & Disclaimer</h1>
      <p class="page-lead">Last updated: August 24, 2026</p>
    </div>
  </div>

  <section class="content-section">
    <div class="container container-narrow">
      <h2>Terms of Use</h2>
      <p>
        By accessing or using MockAgent.AI, you agree to these Terms of Use. If you do not agree, please do not 
        use the site.
      </p>
      <p>
        All content on this site is provided for educational and informational purposes only. We reserve the right 
        to modify, update, or remove content at any time without notice.
      </p>

